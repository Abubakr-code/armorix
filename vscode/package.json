{
  "name": "armorix",
  "displayName": "Armorix \u2014 offline AI code auditor",
  "description": "Finds SQL injection, XSS, secrets, memory bugs (C/C++) and vulnerable dependencies as you code \u2014 and fixes them with a local AI. Your code never leaves the machine.",
  "version": "0.3.13",
  "publisher": "armorix",
  "license": "SEE LICENSE IN README.md",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abubakr-code/armorix.git"
  },
  "homepage": "https://abubakr-code.github.io",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "vulnerability",
    "offline",
    "ai",
    "cwe",
    "owasp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:php",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "workspaceContains:**/package-lock.json",
    "workspaceContains:**/requirements.txt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "armorix.scanFile",
        "title": "Armorix: Scan current file",
        "icon": "$(shield)"
      },
      {
        "command": "armorix.scanWorkspace",
        "title": "Armorix: Scan workspace"
      },
      {
        "command": "armorix.fixFinding",
        "title": "Armorix: Fix with local AI"
      },
      {
        "command": "armorix.clear",
        "title": "Armorix: Clear findings"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "armorix.scanFile",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "armorix.fixFinding",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Armorix",
      "properties": {
        "armorix.path": {
          "type": "string",
          "default": "",
          "description": "Path to the armorix executable. Empty: search PATH and the Armorix desktop app install. (user / machine setting only \u2014 a workspace cannot change which program runs)",
          "scope": "machine"
        },
        "armorix.language": {
          "type": "string",
          "enum": [
            "uz",
            "ru",
            "en"
          ],
          "default": "uz",
          "description": "Language of messages (O'zbek / \u0420\u0443\u0441\u0441\u043a\u0438\u0439 / English)."
        },
        "armorix.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan a file every time it is saved."
        },
        "armorix.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Scan a file when it is opened."
        },
        "armorix.minSeverity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "low",
          "description": "Hide findings below this severity."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "type": "commonjs",
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Armorix still scans, but never takes the program path from workspace settings.",
      "restrictedConfigurations": [
        "armorix.path"
      ]
    }
  }
}
