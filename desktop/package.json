{
  "name": "armorix-desktop",
  "productName": "Armorix",
  "version": "0.3.10",
  "description": "Offline AI code auditor for developers",
  "author": "Armorix",
  "homepage": "https://armorix.security",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "security.armorix.desktop",
    "productName": "Armorix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/llama",
        "to": "llama",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Offline AI code auditor",
      "maintainer": "Armorix <hello@armorix.security>",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2 | libasound2t64"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "artifactName": "Armorix-${os}-${arch}.${ext}",
    "publish": null,
    "icon": "build/icon.png"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "desktopName": "armorix.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abubakr-code/armorix.git"
  }
}
